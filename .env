# Database
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress

# Ports
WORDPRESS_PORT=8082        # ✅ để khớp với docker-compose (WordPress chạy cổng 8082)
PHPMYADMIN_PORT=8081      # ✅ giữ nguyên, phpMyAdmin chạy 8081
DB_PORT=3307              # ✅ vì chúng ta đã đổi port MySQL ra 3307 trên máy host
